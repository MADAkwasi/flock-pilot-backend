// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole{
  FARMER
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FarmType {
  BROILER
  LAYER
  MIXED
}

enum FlockType {
  BROILER
  LAYER
}

enum FlockStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

enum ExpenseType {
  PURCHASE
  SERVICE
  MAINTENANCE
  LOSS
  ADJUSTMENT
}

enum InventoryCategory {
  FEED
  EGGS
  MEDICATION
  CRATE
  EQUIPMENT
  SUPPLEMENT
  OTHER
}

enum InventoryTransactionType {
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  LOSS
  PRODUCTION
  SALE
  REVERSAL  
  OPENING_BALANCE
}

enum SaleType {
  BIRD
  EGG
  INVENTORY
}

enum ExpenseCategory {
  FEED
  MEDICATION
  INVENTORY
  LABOR
  TRANSPORT
  EQUIPMENT
  UTILITIES
  MAINTENANCE
  OTHER
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String 
  name String
  role UserRole @default(FARMER)
  farms Farm[]
  aiLogs AiInteraction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id String @id @default(uuid())
  name String
  location String?
  description String?
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  farmType FarmType?
  flocks Flock[]
  expenses Expense[]
  inventoryItems InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  sales Sale[]
  aiLogs AiInteraction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Flock{
  id String @id @default(uuid())
  name String @unique
  breed String?
  flockType FlockType
  currentCount Int 
  initialCount Int
  source String?
  status FlockStatus @default(ACTIVE)
  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  notes FlockNote[]
  feed FeedLog[]
  health HealthRecord[]
  eggs EggProduction[]
  expenses Expense[]
  mortality MortalityRecord[]
  inventoryTransactions InventoryTransaction[]
  sales Sale[]
  startDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

model Expense {
  id String @id @default(uuid())

  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  flockId String?
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  inventoryItemId String?
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  type ExpenseType
  category ExpenseCategory

  amount Float

  description String?

  createdAt DateTime @default(now())

  @@index([flockId, farmId])
}

model FeedLog{
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityKg Float
  notes String?
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model HealthRecord{
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id], onDelete: Cascade)
  diagnosis String
  severity Severity
  treatment String?
  medication String?
  affectedCount Int?
  vetNotes String?
  recordedAt DateTime
  createdAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model EggProduction {
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id], onDelete: Cascade)
  count Int
  broken Int @default(0)
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model MortalityRecord {
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id], onDelete: Cascade)
  count Int
  cause String?
  notes String?
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model FlockNote{
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id], onDelete: Cascade)
  content String
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model InventoryItem {
  id String @id @default(uuid())

  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  name String
  category InventoryCategory
  unit String // e.g. "kg", "bags", "boxes"
  feedLog FeedLog[]
  expense Expense[]
  transactions InventoryTransaction[]
  
  isDeleted Boolean @default(false)

  reorderLevel Float?

  costPerUnit Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([farmId])
  @@unique([farmId, name, category])
}

model InventoryTransaction {
  id String @id @default(uuid())

  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  flockId String?
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  inventoryItemId String
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  type InventoryTransactionType

  quantity Float
  unitCost Float?

  source String?
  referenceId String?

  notes String?

  createdAt DateTime @default(now())

  @@index([farmId, flockId])
}

model Sale {
  id String @id @default(uuid())

  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  flockId String?
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  type SaleType

  quantity Float

  unitPrice Float

  totalAmount Float

  customerName String?

  notes String?

  soldAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([farmId, flockId])
}

model AiInteraction {
  id String @id @default(ulid())
  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  role AiRole
  message String
  metadata Json?
  createdAt DateTime @default(now())
}

