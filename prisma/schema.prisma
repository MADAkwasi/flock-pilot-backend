// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole{
  FARMER
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiRole {
  USER
  ASSISTANT
}

enum FarmType {
  BROILER
  LAYER
  MIXED
}

enum FlockType {
  BROILER
  LAYER
}

enum FlockStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

enum ExpenseType {
  FEED
  MEDICATION
  INVENTORY
  LABOR
  TRANSPORT
  OTHER
}

model User {
  id String @id @default(uuid())
  email String @unique
  password String 
  name String
  role UserRole @default(FARMER)
  farms Farm[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id String @id @default(uuid())
  name String
  location String?
  description String?
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  farmType FarmType?
  flocks Flock[]
  expenses Expense[]
  aiLogs AiInteraction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Flock{
  id String @id @default(uuid())
  name String @unique
  breed String?
  flockType FlockType
  currentCount Int 
  initialCount Int
  source String?
  status FlockStatus @default(ACTIVE)
  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  notes FlockNote[]
  feed FeedLog[]
  health HealthRecord[]
  eggs EggProduction[]
  expenses Expense[]
  mortality MortalityRecord[]
  startDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
}

model Expense {
  id String @id @default(uuid())

  farmId String
  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  flockId String?
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  type ExpenseType
  category String

  amount Float

  description String?

  occurredAt DateTime
  createdAt DateTime @default(now())

  @@index([flockId, farmId])
}

model FeedLog{
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id])
  feedType String
  quantityKg Float
  notes String?
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model HealthRecord{
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id])
  diagnosis String
  severity Severity
  treatment String?
  medication String?
  vetNotes String?
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model EggProduction {
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id])
  count Int
  broken Int @default(0)
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model MortalityRecord {
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id])
  count Int
  cause String?
  notes String?
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model FlockNote{
  id String @id @default(uuid())
  flockId String
  flock Flock @relation(fields: [flockId], references: [id])
  content String
  recordedAt DateTime @default(now())

  @@index([flockId, recordedAt])
}

model AiInteraction {
  id String @id @default(ulid())
  farmId String
  farm Farm @relation(fields: [farmId], references: [id])
  role AiRole
  message String
  metadata Json?
  createdAt DateTime @default(now())
}

